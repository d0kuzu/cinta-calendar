# Port to expose via Docker
PORT=3000

# Backend base URL (without trailing slash)
VITE_API_BASE_URL=https://api.zerde.co/diaxel/ai

# CampusLogin organization on backend side: cinta | canada
VITE_ORGANIZATION=cinta

# CampusLogin staff id (12001 = Anna Clenshaw)
VITE_STAFF_ID=12001

# Slot duration in minutes
VITE_DURATION=60
